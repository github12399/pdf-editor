{
  "name": "pdf-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "app:start": "electron .",
    "app:build": "pnpm build && electron-builder --win -c.electronDist=node_modules/electron/dist",
    "app:build:linux": "pnpm build && electron-builder --linux",
    "app:build:mac": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "idb": "^8.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller"
    ]
  },
  "desktopName": "pdf-editor.desktop"
}
